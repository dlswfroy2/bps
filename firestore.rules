
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- হেল্পার ফাংশনসমূহ ---
    
    function isAuthed() {
      return request.auth != null;
    }

    function hasUserData() {
      return isAuthed() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return hasUserData() && getUserData().role == 'admin';
    }

    function hasPermission(permission) {
      return hasUserData() && (
        getUserData().role == 'admin' || 
        (permission in getUserData().get('permissions', []))
      );
    }

    // --- কালেকশন ভিত্তিক রুলস ---

    match /syllabi/{id} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (hasPermission('manage:lesson-plans') || hasPermission('manage:syllabus') || isAdmin());
    }

    match /lessonPlans/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed() && hasPermission('manage:lesson-plans');
      allow update: if isAuthed() && (hasPermission('manage:lesson-plans') || isAdmin());
      allow delete: if isAdmin();
    }

    match /admissionApplications/{id} {
      allow create: if true;
      allow read, write: if isAuthed() && hasPermission('manage:admissions');
    }

    match /school/info {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /school/gallery {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow list: if isAuthed(); 
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAdmin() || (isAuthed() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']));
      allow delete: if isAdmin();
    }

    match /classRoutines/{id} {
      allow read: if true;
      allow write: if isAuthed() && (hasPermission('manage:routines') || isAdmin());
    }

    match /teacherAllocations/{id} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (hasPermission('manage:routines') || isAdmin());
    }

    match /proxyClasses/{id} {
      allow read: if true;
      allow write: if isAuthed() && (hasPermission('manage:proxy-classes') || isAdmin());
    }

    match /notices/{id} {
      allow read: if true; 
      allow write: if isAuthed() && hasPermission('manage:notices');
      allow delete: if isAdmin() || (isAuthed() && hasPermission('manage:notices'));
    }

    match /holidays/{id} {
      allow read: if true;
      allow write: if isAuthed(); 
      allow delete: if isAdmin();
    }
    
    match /exams/{id} {
      allow read: if true;
      allow write: if isAuthed(); 
    }

    match /students/{id} {
      allow read: if true; 
      allow write: if isAuthed() && (hasPermission('manage:students') || hasPermission('special:edit-student') || hasPermission('manage:fee-setup') || isAdmin());
      allow delete: if isAdmin() || hasPermission('special:delete-student');
    }
    
    match /staff/{id} {
      allow read: if true;
      allow write: if isAuthed() && (hasPermission('manage:staff') || isAdmin());
      allow delete: if isAdmin();
    }

    match /staffAttendance/{id} {
      allow read: if true; // Allow public read for landing page leave stats
      allow write: if isAuthed() && (hasPermission('manage:staff-attendance') || isAdmin());
    }

    match /attendance/{id} {
      allow read: if true; // Allow public read for landing page stats
      allow write: if isAuthed() && (hasPermission('manage:attendance') || hasPermission('input:quick-roll-attendance') || hasPermission('input:missed-attendance') || isAdmin());
      allow delete: if isAdmin() || hasPermission('manage:attendance');
    }
    
    match /results/{id} {
      allow read: if true;
      allow write: if isAuthed() && (hasPermission('input:results') || hasPermission('manage:results') || isAdmin());
      allow delete: if isAdmin();
    }

    match /specialResults/{id} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (hasPermission('input:results') || hasPermission('manage:results') || hasPermission('manage:special-results') || isAdmin());
      allow delete: if isAdmin();
    }

    match /messageLogs/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed() && (hasPermission('send:messaging') || isAdmin());
      allow update, delete: if isAuthed() && (hasPermission('manage:messaging') || isAdmin());
    }

    match /feeCollections/{id} {
      allow read: if isAuthed();
      allow create, update: if isAuthed() && (hasPermission('collect:fees') || isAdmin());
      allow delete: if isAdmin() || hasPermission('special:delete-transaction');
    }

    match /transactions/{id} {
      allow read: if isAuthed();
      allow write, delete: if isAuthed() && (hasPermission('manage:transactions') || hasPermission('collect:fees') || isAdmin());
    }

    match /publicExamRecords/{id} {
      allow read: if true; // Allow public read for landing page stats
      allow write: if isAuthed() && (hasPermission('manage:public-records') || isAdmin());
      allow delete: if isAdmin();
    }

    match /archiveFolders/{id} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (hasPermission('manage:archive') || isAdmin());
    }

    match /archivedDocuments/{id} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (hasPermission('manage:documents') || hasPermission('manage:archive') || isAdmin());
    }
  }
}
